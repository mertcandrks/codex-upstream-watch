{
  "description": "Opt-in upstream checks during active Codex work; no daemon or automatic merge.",
  "hooks": {
    "SessionStart": [{ "matcher": "startup|resume", "hooks": [{ "type": "command", "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT || process.env.CLAUDE_PLUGIN_ROOT, 'scripts/check-upstream.cjs')).main()\"", "timeout": 25, "statusMessage": "Checking configured upstream", "async": true }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT || process.env.CLAUDE_PLUGIN_ROOT, 'scripts/check-upstream.cjs')).main()\"", "timeout": 25, "async": true }] }],
    "PostToolUse": [{ "matcher": "Bash|apply_patch|Edit|Write", "hooks": [{ "type": "command", "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT || process.env.CLAUDE_PLUGIN_ROOT, 'scripts/check-upstream.cjs')).main()\"", "timeout": 25, "async": true }] }]
  }
}
